# PostgreSQL local development configuration
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Use this from a backend running directly on your machine.
DATABASE_URL=

# Model provider keys. Keep real values in .env only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# xAI/Grok OpenAI-compatible endpoint.
XAI_BASE_URL=https://api.x.ai/v1
XAI_DEFAULT_MODEL=grok-4.3
AWS_BEDROCK_REGION=us-east-1

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_WORKFLOW_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_SENDER_IDS=