# PostgreSQL local development configuration
POSTGRES_DB=nxflow
POSTGRES_USER=nxflow
POSTGRES_PASSWORD=nxflow
POSTGRES_PORT=5432

# Use this from a backend running directly on your machine.
DATABASE_URL=postgresql+asyncpg://nxflow:nxflow@localhost:5432/nxflow

# Model provider keys. Keep real values in .env only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Groq OpenAI-compatible endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
AWS_BEDROCK_REGION=us-east-1
